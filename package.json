{
  "name": "swarm-engine-team",
  "version": "0.1.0",
  "description": "Terminal tool that runs multiple AI coding CLIs in separate WezTerm panes (orchestrator + 2x3 worker grid).",
  "type": "module",
  "bin": {
    "swarm": "./bin/swarm.js",
    "team": "./bin/swarm.js"
  },
  "scripts": {
    "test": "node --test test/swarm.test.js",
    "doctor": "node ./bin/swarm.js doctor",
    "dry-run": "node ./bin/swarm.js --dry-run",
    "start": "node ./bin/swarm.js",
    "stop": "node ./bin/swarm.js stop",
    "status": "node ./bin/swarm.js status"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
